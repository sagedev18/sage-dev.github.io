# Copy this file to .env and change the values before going live.

# ---------- Core ----------

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-string-before-deploying

# How long a login stays valid.
JWT_EXPIRES_IN=7d

# Port the server runs on.
PORT=3000

# Set to "production" when you deploy. It stops the server
# from showing detailed error messages to visitors.
NODE_ENV=development

# The public address of the site. Used to build password reset links.
APP_URL=http://localhost:3000

# Comma separated list of emails that become administrators when they sign up.
# Anyone already in the database keeps admin access even if this is cleared.
ADMIN_EMAILS=admin@studyflow.app

# ---------- Password reset (development only) ----------

# Set to "true" while developing, with no email provider configured, to get
# the reset link returned in the API response instead of being emailed.
# NEVER set this in production.
EXPOSE_RESET_TOKEN=false

# ---------- Email delivery ----------

# With no key below, emails are printed to the server console instead of
# being sent. Nothing breaks, but nobody receives them.

# Option A: Resend (simplest)
RESEND_API_KEY=
MAIL_FROM=StudyFlow <onboarding@resend.dev>

# Option B: SMTP (any provider, e.g. Gmail, Mailgun, SendGrid)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---------- AI assistant ----------

# With no key below, the assistant answers only from the student's own
# notes, syllabus and tasks. Nothing breaks, but answers are limited.

# Option A: OpenAI-compatible provider (OpenAI, Groq, Together, OpenRouter...)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Option B: Anthropic
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5

# ---------- Store settings ----------

# These are only defaults. Once you are signed in as an administrator you can
# change the price and bank details from /admin.html, and those win.

PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_DETAILS=
SUPPORT_EMAIL=